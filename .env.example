# --- Database & queues (docker compose defaults) ---
DATABASE_URL=postgresql://trafy:trafy@localhost:5432/trafy_community
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Any random long string in dev. Rotate + move to a secrets manager in prod.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_TTL_SECONDS=300

# --- Email/OTP provider (optional — env-gated) ---
# Leave unset in dev: OTP codes are logged to the API console instead of emailed.
RESEND_API_KEY=

# --- OAuth (optional — env-gated) ---
# Leave unset in dev: OAuth buttons will not appear on the sign in page.
# Set these to enable Google and LinkedIn sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- AI Parsing (optional — env-gated) ---
# Set either to enable AI resume parsing during onboarding.
GEMINI_API_KEY=
OPENAI_API_KEY=
# --- Object storage (optional — env-gated) ---
# Leave unset in dev: certificate/profile uploads are written to apps/api/uploads
# and served from the API — fine for one instance, but files don't survive a
# redeploy and don't work across multiple instances. Set S3_ENDPOINT + bucket
# + keys to switch to real S3-compatible storage (AWS S3, Cloudflare R2,
# DigitalOcean Spaces, Backblaze B2, self-hosted MinIO, ...); all four are
# required together once S3_ENDPOINT is set.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "auto" works for Cloudflare R2; AWS S3 needs a real region (e.g. us-east-1).
S3_REGION=auto
# Most non-AWS providers need this (MinIO, R2, Spaces); set to false only for
# AWS S3 itself if you specifically need virtual-hosted-style URLs.
S3_FORCE_PATH_STYLE=true
# Optional: a public/CDN host in front of the bucket, if the bucket isn't
# served directly from S3_ENDPOINT (e.g. an R2 public bucket URL, or
# CloudFront in front of an S3 bucket). Falls back to path-style off
# S3_ENDPOINT itself when unset.
S3_PUBLIC_URL=

# --- Code-grading sandbox (optional — env-gated) ---
# Leave unset in dev: code questions are graded by a deterministic keyword
# rubric instead of executing the submission. Point this at a Judge0 instance
# to run hidden test cases for real.
JUDGE0_URL=

# --- Live classes (optional — env-gated, no meaningful stub) ---
# Leave unset in dev: "Join live class" fails with a clear "not configured"
# message instead of pretending a session can be joined — there's no
# low-fidelity fallback for real-time video like there is for email/storage.
# Point these at a LiveKit Cloud project or a self-hosted LiveKit server to
# enable it for real.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Services ---
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000
WEB_URL=http://localhost:3000

# --- Mobile (apps/mobile) ---
# Leave unset to auto-derive the API/web URLs from the Expo dev server's own
# host IP (works out of the box for a physical device on the same Wi-Fi as
# your dev machine). Set these if that guess is wrong, or for simulators/emulators.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_URL=

# --- Error tracking (optional — env-gated) ---
# Leave unset in dev: apps/api, apps/web, and apps/mobile all initialize
# Sentry as a harmless no-op (every Sentry.* call becomes a stub) — errors
# just log to the console like today. Create a Sentry project (one per app,
# or one project with separate DSNs) and set these to start capturing.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only — enables source map upload during `next build` /
# `expo prebuild`. Never commit this; keep it in CI secrets or a
# gitignored .env.sentry-build-plugin.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Product analytics (optional — env-gated) ---
# Leave unset in dev: apps/api, apps/web, and apps/mobile all skip PostHog
# initialization — capture()/identify() calls become no-ops. Create a
# PostHog project (app.posthog.com/project/settings) and set these to start
# tracking signups, logins, and feature usage.
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# US Cloud shown above — use https://eu.i.posthog.com (and EU host below) if
# your PostHog project is on EU Cloud.
POSTHOG_HOST=https://us.i.posthog.com

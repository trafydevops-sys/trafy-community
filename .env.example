# --- Database & queues (docker compose defaults) ---
DATABASE_URL=postgresql://trafy:trafy@localhost:5432/trafy_community
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Any random long string in dev. Rotate + move to a secrets manager in prod.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_TTL_SECONDS=300

# --- Email/OTP provider (optional — env-gated) ---
# Leave unset in dev: OTP codes are logged to the API console instead of emailed.
RESEND_API_KEY=

# --- OAuth (optional — env-gated) ---
# Leave unset in dev: OAuth buttons will not appear on the sign in page.
# Set these to enable Google and LinkedIn sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- AI Parsing (optional — env-gated) ---
# Set either to enable AI resume parsing during onboarding.
GEMINI_API_KEY=
OPENAI_API_KEY=
# --- Object storage (optional — env-gated) ---
# Leave unset in dev: certificate/profile uploads are written to apps/api/uploads
# and served from the API. Set these to switch to S3-compatible storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Code-grading sandbox (optional — env-gated) ---
# Leave unset in dev: code questions are graded by a deterministic keyword
# rubric instead of executing the submission. Point this at a Judge0 instance
# to run hidden test cases for real.
JUDGE0_URL=

# --- Live classes (optional — env-gated, no meaningful stub) ---
# Leave unset in dev: "Join live class" fails with a clear "not configured"
# message instead of pretending a session can be joined — there's no
# low-fidelity fallback for real-time video like there is for email/storage.
# Point these at a LiveKit Cloud project or a self-hosted LiveKit server to
# enable it for real.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Services ---
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000
WEB_URL=http://localhost:3000

# --- Mobile (apps/mobile) ---
# Leave unset to auto-derive the API/web URLs from the Expo dev server's own
# host IP (works out of the box for a physical device on the same Wi-Fi as
# your dev machine). Set these if that guess is wrong, or for simulators/emulators.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WEB_URL=

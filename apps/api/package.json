{
  "name": "@trafy-community/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --max-old-space-size=1536 ../../node_modules/vitest/vitest.mjs run --pool=forks --poolOptions.forks.singleFork=true",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.2",
    "@trafy-community/core": "0.1.0",
    "@trafy-community/db": "0.1.0",
    "@trpc/server": "^10.45.2",
    "bullmq": "^5.34.8",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "livekit-server-sdk": "^2.17.0",
    "playwright": "^1.62.1",
    "resend": "^6.18.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}

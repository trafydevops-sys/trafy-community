{
  "name": "@trafy-community/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/server.ts",
    "build": "tsc -p tsconfig.json",
    "// start": "Deliberately NOT `node dist/server.js`: @trafy-community/core and /db are consumed as raw TS (package.json main points at src/index.ts, matching how apps/web and apps/mobile already consume them), which plain `node` cannot load — it throws ERR_UNKNOWN_FILE_EXTENSION. tsx is the one runtime already proven to handle this (dev/worker have always used it); start/start:worker now match, so 'the thing that runs in prod' and 'the thing devs run locally' are the same code path.",
    "start": "tsx --import ./src/instrument.ts src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --max-old-space-size=1536 ../../node_modules/vitest/vitest.mjs run --pool=forks --poolOptions.forks.singleFork=true",
    "worker": "tsx --import ./src/instrument.ts src/worker.ts",
    "start:worker": "tsx --import ./src/instrument.ts src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.0.2",
    "@sentry/node": "^10.69.0",
    "@trafy-community/core": "0.1.0",
    "@trafy-community/db": "0.1.0",
    "@trpc/server": "^10.45.2",
    "archiver": "^8.0.0",
    "bullmq": "^5.34.8",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "livekit-server-sdk": "^2.17.0",
    "otpauth": "^9.5.1",
    "playwright": "^1.62.1",
    "posthog-node": "^5.21.2",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
